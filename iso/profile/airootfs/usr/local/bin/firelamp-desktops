#!/usr/bin/env python3
"""Install other desktops and window managers on demand, so the ISO only ships KDE Plasma.

    firelamp-desktops list             what can be installed, and what already is
    firelamp-desktops install ID       install one (pacman, --needed)
    firelamp-desktops packs            the software packs (Dev, Make, Rice, Play, Office)
    firelamp-desktops install-pack ID  install a pack;  remove-pack ID removes it
    firelamp-desktops browsers         the browsers you can pick, and which one is the default
    firelamp-desktops browser ID       install it if needed and make it the default
    firelamp-desktops launcher         open (or close) the shell's launcher, as the Super key does
    firelamp-desktops serve            local API for Settings > Desktops and Packs (127.0.0.1:7341)

The shell's Settings page talks to `serve` over plain HTTP on localhost:
    GET  /desktops        -> [{id, name, installed, state, log}]
    POST /install/ID      -> starts the install, returns at once
    GET  /packs           -> [{id, name, installed, state, log, packages}]
    POST /install-pack/ID, /remove-pack/ID
    GET  /browsers        -> {default, browsers:[{id, installed, state, log}]}
    POST /browser/ID      -> install (if needed) and set as the default browser
    GET  /live            -> {live}: true on the live ISO (/run/archiso exists)
    POST /install-os      -> opens the installer (firelamp-install), live ISO only
    GET  /events?after=N  -> {last, events:[{n, kind}]}; waits up to 25 s for one (long poll);
                             after=-1 answers at once, with where the queue is
    POST /event/launcher  -> tells the shell to toggle its launcher
    GET  /apps            -> {files, web, mail, photos, music, calendar, terminal, settings: app or null}
    POST /open/APP[/ARG]  -> opens the real app (terminal = Konsole running bash; kcm/wifi = a
                             KDE settings page; files/Downloads, files/trash)
    GET  /system          -> {wifi, bluetooth, volume, muted}; null when there's no such hardware
    POST /system/wifi|bluetooth/on|off, /system/volume/0-100
    POST /power/lock|sleep|restart|shutdown|logout
    GET  /debug           -> what the shell acknowledged, the last /raise result, recent events
    POST /raise           -> brings the Firelamp shell window to the front (KWin script)

The Super key: KWin's ModifierOnlyShortcuts calls org.firelamp.Shell.ToggleLauncher on the
session bus (see /etc/xdg/kwinrc). `serve` owns that name and turns the call into a
"launcher" event, so Super opens Firelamp's launcher instead of Plasma's.
Only the IDs below can be installed; nothing else is passed to pacman.
Each one ships a wayland-sessions/xsessions entry, so it shows up at login.
"""
import json, os, re, shutil, subprocess, sys, tempfile, threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 7341
CATALOG = {
    "plasma":   {"name": "KDE Plasma", "probe": "plasma-desktop", "packages": ["plasma-meta"]},
    "gnome":    {"name": "GNOME", "probe": "gnome-shell", "packages": ["gnome"]},
    "cosmic":   {"name": "COSMIC", "probe": "cosmic-session", "packages": ["cosmic"]},
    "xfce":     {"name": "Xfce", "probe": "xfce4-session", "packages": ["xfce4", "xfce4-goodies"]},
    "hyprland": {"name": "Hyprland", "probe": "hyprland",
                 "packages": ["hyprland", "xdg-desktop-portal-hyprland", "hyprpaper", "hyprlock", "waybar", "fuzzel", "mako", "kitty"]},
    "niri":     {"name": "niri", "probe": "niri",
                 "packages": ["niri", "xdg-desktop-portal-gnome", "swaybg", "swaylock", "waybar", "fuzzel", "mako", "alacritty"]},
    "sway":     {"name": "Sway", "probe": "sway",
                 "packages": ["sway", "swaybg", "swayidle", "swaylock", "waybar", "fuzzel", "mako", "foot"]},
}
# Packs (DIRECTION §13): optional, nothing pre-selected. Official repos only; AUR tools such as
# pywal16 and matugen are left out until there is a safe AUR path.
PACKS = {
    "dev":    {"name": "Dev", "packages": ["git", "base-devel", "neovim", "code", "podman", "nodejs", "npm", "python", "rustup", "go"]},
    "make":   {"name": "Make", "packages": ["gimp", "krita", "inkscape", "kdenlive", "obs-studio"]},
    "rice":   {"name": "Rice", "packages": ["kvantum", "fastfetch", "starship", "btop", "cava"]},
    "play":   {"name": "Play", "packages": ["steam", "lutris", "gamemode", "mangohud"]},
    "office": {"name": "Office", "packages": ["libreoffice-fresh", "thunderbird"]},
}
# Browsers: how to get each one, and the .desktop file that makes it the default.
# repo = Arch/CachyOS packages (root), flatpak = Flathub per user, aur = paru when present.
FLATHUB = "https://dl.flathub.org/repo/flathub.flatpakrepo"
BROWSERS = {
    "firefox":     ("repo", "firefox", "firefox.desktop"),
    "chrome":      ("flatpak", "com.google.Chrome", None),
    "brave":       ("flatpak", "com.brave.Browser", None),
    "edge":        ("flatpak", "com.microsoft.Edge", None),
    "vivaldi":     ("repo", "vivaldi", "vivaldi-stable.desktop"),
    "opera":       ("flatpak", "com.opera.Opera", None),
    "helium":      ("aur", "helium-browser-bin", None),
    "librewolf":   ("flatpak", "io.gitlab.librewolf-community", None),
    "mullvad":     ("flatpak", "net.mullvad.MullvadBrowser", None),
    "tor":         ("repo", "torbrowser-launcher", "torbrowser.desktop"),
    "ungoogled":   ("flatpak", "io.github.ungoogled_software.ungoogled_chromium", None),
    "zen":         ("flatpak", "app.zen_browser.zen", None),
    "floorp":      ("flatpak", "one.ablaze.floorp", None),
    "waterfox":    ("flatpak", "net.waterfox.waterfox", None),
    "chromium":    ("repo", "chromium", "chromium.desktop"),
    "thorium":     ("aur", "thorium-browser-bin", None),
    "falkon":      ("repo", "falkon", "org.kde.falkon.desktop"),
    "konqueror":   ("repo", "konqueror", "org.kde.konqueror.desktop"),
    "epiphany":    ("repo", "epiphany", "org.gnome.Epiphany.desktop"),
    "qutebrowser": ("repo", "qutebrowser", "org.qutebrowser.qutebrowser.desktop"),
    "nyxt":        ("repo", "nyxt", "nyxt.desktop"),
    "ladybird":    ("aur", "ladybird-git", None),
}
# The app icon each tile shows, the way the dock shows any app: the installed launcher's Icon=,
# else the icon from Flathub's appstream data (the Flathub id doubles as the lookup for repo
# browsers that are also on Flathub). No icon: the shell falls back to a monogram.
FLATHUB_IDS = {
    "firefox": "org.mozilla.firefox", "vivaldi": "com.vivaldi.Vivaldi", "tor": "org.torproject.torbrowser-launcher",
    "chromium": "org.chromium.Chromium", "falkon": "org.kde.falkon", "konqueror": "org.kde.konqueror",
    "epiphany": "org.gnome.Epiphany", "qutebrowser": "org.qutebrowser.qutebrowser", "nyxt": "engineer.atlas.Nyxt",
}
ICON_ROOTS = [os.path.expanduser("~/.local/share/flatpak/exports/share/icons/hicolor"),
              "/var/lib/flatpak/exports/share/icons/hicolor", "/usr/share/icons/hicolor"]
APPSTREAM = [os.path.expanduser("~/.local/share/flatpak/appstream/flathub/{arch}/active/icons/128x128"),
             "/var/lib/flatpak/appstream/flathub/{arch}/active/icons/128x128"]
# events for the shell (it long-polls GET /events): the Super key, for now
events = []
events_cv = threading.Condition()


def push_event(kind):
    with events_cv:
        events.append({"n": (events[-1]["n"] + 1) if events else 1, "kind": kind})
        del events[:-50]
        events_cv.notify_all()


def events_after(n, wait=25):
    with events_cv:
        if n >= 0:  # after=-1: just say where the queue is, without waiting
            events_cv.wait_for(lambda: events and events[-1]["n"] > n, timeout=wait)
        newer = [e for e in events if e["n"] > n]
        return {"last": events[-1]["n"] if events else 0, "events": newer}


DBUS_XML = """<node><interface name="org.firelamp.Shell">
  <method name="ToggleLauncher"/>
</interface></node>"""


def serve_dbus():
    """Own org.firelamp.Shell on the session bus, for KWin's Super-key shortcut."""
    try:
        import gi
        from gi.repository import Gio, GLib
    except Exception as e:  # no PyGObject: Super stays with Plasma
        print("firelamp-desktops: no D-Bus service:", e, file=sys.stderr)
        return
    node = Gio.DBusNodeInfo.new_for_xml(DBUS_XML)

    def on_call(conn, sender, path, iface, method, params, invocation):
        if method == "ToggleLauncher":
            push_event("launcher")
        invocation.return_value(None)

    def on_bus(conn, name):
        conn.register_object("/org/firelamp/Shell", node.interfaces[0], on_call, None, None)

    Gio.bus_own_name(Gio.BusType.SESSION, "org.firelamp.Shell", Gio.BusNameOwnerFlags.NONE, on_bus, None, None)
    GLib.MainLoop().run()


jobs = {}   # id -> {"state": "installing"|"installed"|"failed", "log": last line}


def query(*pkgs):
    try:
        return subprocess.run(["pacman", "-Q", *pkgs], capture_output=True).returncode == 0
    except FileNotFoundError:          # not an Arch system
        return False


def installed(pkg):
    return query(pkg)


def privileged(cmd):
    # the live user has passwordless sudo; an installed system asks through polkit
    if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
        return ["sudo", "-n", *cmd]
    if shutil.which("pkexec"):
        return ["pkexec", *cmd]
    return cmd


def run_job(key, cmd, check):
    jobs[key] = {"state": "installing", "log": "Starting"}
    p = subprocess.Popen(privileged(cmd), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in p.stdout:
        line = line.strip()
        if line:
            jobs[key]["log"] = line[-120:]
    ok = p.wait() == 0 and check()
    jobs[key] = {"state": "installed" if ok else "failed", "log": jobs[key]["log"]}
    return ok


def install(did):
    d = CATALOG[did]
    return run_job(did, ["pacman", "-S", "--needed", "--noconfirm", *d["packages"]], lambda: installed(d["probe"]))


def run_quiet(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", "")


def browser_desktop(bid):
    via, name, desktop = BROWSERS[bid]
    if via == "flatpak":
        return name + ".desktop"
    if desktop:
        return desktop
    # AUR packages: find the launcher the package ships
    for line in run_quiet(["pacman", "-Qlq", name]).stdout.splitlines():
        if line.startswith("/usr/share/applications/") and line.endswith(".desktop"):
            return os.path.basename(line)
    return None


def browser_installed(bid):
    via, name, _ = BROWSERS[bid]
    if via == "flatpak":
        return run_quiet(["flatpak", "info", "--user", name]).returncode == 0 or run_quiet(["flatpak", "info", name]).returncode == 0
    return query(name)


def theme_icon(name):
    if os.path.isabs(name):
        return name if os.path.isfile(name) else None
    for root in ICON_ROOTS:
        for size in ("scalable", "256x256", "128x128", "96x96", "64x64", "48x48"):
            for ext in (".svg", ".png"):
                f = os.path.join(root, size, "apps", name + ext)
                if os.path.isfile(f):
                    return f
    for ext in (".svg", ".png"):
        if os.path.isfile("/usr/share/pixmaps/" + name + ext):
            return "/usr/share/pixmaps/" + name + ext
    return None


def browser_icon(bid):
    via, name, _ = BROWSERS[bid]
    desktop = browser_desktop(bid) if browser_installed(bid) else None
    if desktop:
        for d in ("~/.local/share/flatpak/exports/share/applications", "/var/lib/flatpak/exports/share/applications", "/usr/share/applications"):
            f = os.path.join(os.path.expanduser(d), desktop)
            if os.path.isfile(f):
                with open(f, errors="replace") as fh:
                    for line in fh:
                        if line.startswith("Icon="):
                            icon = theme_icon(line[5:].strip())
                            if icon:
                                return icon
                            break
                break
    fid = name if via == "flatpak" else FLATHUB_IDS.get(bid)
    if fid:
        arch = os.uname().machine
        for d in APPSTREAM:
            f = os.path.join(d.format(arch=arch), fid + ".png")
            if os.path.isfile(f):
                return f
    return None


def refresh_appstream():
    """Fetch Flathub's catalog once, so tiles get real icons before anything is installed."""
    if shutil.which("flatpak"):
        run_quiet(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB])
        run_quiet(["flatpak", "update", "--user", "--appstream", "flathub"])


def default_browser():
    cur = run_quiet(["xdg-settings", "get", "default-web-browser"]).stdout.strip()
    for bid in BROWSERS:
        if cur and cur == browser_desktop(bid):
            return bid
    return "firefox" if not cur else cur


def pick_browser(bid):
    """Install the browser if it isn't there, then make it the default."""
    via, name, _ = BROWSERS[bid]
    key = "browser:" + bid
    ok = True
    if not browser_installed(bid):
        if via == "repo":
            ok = run_job(key, ["pacman", "-S", "--needed", "--noconfirm", name], lambda: browser_installed(bid))
        elif via == "flatpak":
            run_quiet(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB])
            jobs[key] = {"state": "installing", "log": "Downloading from Flathub"}
            p = subprocess.Popen(["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", name],
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in p.stdout:
                if line.strip():
                    jobs[key]["log"] = line.strip()[-120:]
            ok = p.wait() == 0 and browser_installed(bid)
        elif via == "aur":
            if not shutil.which("paru"):
                jobs[key] = {"state": "failed", "log": "Needs the AUR helper paru"}
                return False
            jobs[key] = {"state": "installing", "log": "Building from the AUR"}
            p = subprocess.Popen(["paru", "-S", "--needed", "--noconfirm", "--skipreview", "--sudo", "pkexec", name],
                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in p.stdout:
                if line.strip():
                    jobs[key]["log"] = line.strip()[-120:]
            ok = p.wait() == 0 and browser_installed(bid)
    if ok:
        desktop = browser_desktop(bid)
        ok = bool(desktop) and run_quiet(["xdg-settings", "set", "default-web-browser", desktop]).returncode == 0
    jobs[key] = {"state": "installed" if ok else "failed", "log": jobs.get(key, {}).get("log", "")}
    return ok


def browser_listing():
    out = []
    for bid in BROWSERS:
        j = jobs.get("browser:" + bid, {})
        out.append({"id": bid, "installed": browser_installed(bid), "via": BROWSERS[bid][0],
                    "state": j.get("state", ""), "log": j.get("log", ""), "icon": browser_icon(bid)})
    return {"default": default_browser(), "browsers": out}


def pack_installed(pid):
    return query(*PACKS[pid]["packages"])


def install_pack(pid):
    return run_job("pack:" + pid, ["pacman", "-S", "--needed", "--noconfirm", *PACKS[pid]["packages"]], lambda: pack_installed(pid))


def remove_pack(pid):
    # -Rs takes each package and the dependencies nothing else needs; base-devel and git stay put
    keep = {"base-devel", "git", "python"}
    pkgs = [p for p in PACKS[pid]["packages"] if p not in keep and installed(p)]
    if not pkgs:
        return True
    return run_job("pack:" + pid, ["pacman", "-Rs", "--noconfirm", *pkgs], lambda: not pack_installed(pid))


def pack_listing():
    out = []
    for pid, d in PACKS.items():
        j = jobs.get("pack:" + pid, {})
        out.append({"id": pid, "name": d["name"], "installed": pack_installed(pid),
                    "state": j.get("state", ""), "log": j.get("log", ""), "packages": d["packages"]})
    return out


def listing():
    out = []
    for did, d in CATALOG.items():
        j = jobs.get(did, {})
        out.append({"id": did, "name": d["name"], "installed": installed(d["probe"]),
                    "state": j.get("state", ""), "log": j.get("log", ""), "packages": d["packages"]})
    return out


# Wayland lets no window raise itself, so when Super opens the launcher over another app
# (the installer, a browser), KWin is asked to activate the shell's window instead.
KWIN_RAISE = """
const all = workspace.windowList();
// the shell's window: titled exactly "Firelamp OS" (the installer is "Firelamp OS Installer");
// else the full-screen window of the qml runtime that hosts the shell
let shell = all.find(w => w.caption === "Firelamp OS")
         || all.find(w => w.fullScreen && /qml|firelamp/i.test(w.resourceClass + " " + w.desktopFileName) && !/Installer/.test(w.caption));
if (shell) {
    shell.minimized = false;
    if (workspace.raiseWindow) workspace.raiseWindow(shell);
    workspace.activeWindow = shell;
}
"""
last_raise = {}
acks = {}


def raise_shell():
    gdbus = shutil.which("gdbus")
    if not gdbus:
        return 404, {"error": "no gdbus"}
    path = os.path.join(tempfile.gettempdir(), f"firelamp-raise-{os.getuid()}.js")
    with open(path, "w") as f:
        f.write(KWIN_RAISE)

    def call(obj, method, *args):
        return subprocess.run([gdbus, "call", "--session", "--dest", "org.kde.KWin", "--object-path", obj,
                               "--method", method, *args], capture_output=True, text=True, timeout=3)
    try:
        call("/Scripting", "org.kde.kwin.Scripting.unloadScript", "firelamp-raise")
        load = call("/Scripting", "org.kde.kwin.Scripting.loadScript", path, "firelamp-raise")
        m = re.search(r"(-?\d+)", load.stdout)
        last_raise.update(load=load.stdout.strip() + load.stderr.strip())
        if not m or int(m.group(1)) < 0:
            return 502, {"error": "KWin didn't load the script", **last_raise}
        run = call(f"/Scripting/Script{m.group(1)}", "org.kde.kwin.Script.run")
        last_raise.update(run=run.stdout.strip() + run.stderr.strip())
        if run.returncode:  # older or newer KWin: start every loaded script instead
            start = call("/Scripting", "org.kde.kwin.Scripting.start")
            last_raise.update(start=start.stdout.strip() + start.stderr.strip())
        return 202, {"ok": True, **last_raise}
    except (OSError, subprocess.TimeoutExpired) as e:
        last_raise.update(error=str(e))
        return 502, {"error": str(e)}


# The dock opens real Linux apps. Each entry is tried in order; the first one installed wins,
# and GET /apps tells the shell which dock items have an app behind them at all.
APPS = {
    "files": ["dolphin", "nautilus", "thunar", "nemo", "pcmanfm-qt"],
    "photos": ["gwenview", "loupe", "eog", "nomacs"],
    "mail": ["thunderbird", "kmail", "evolution", "geary", "betterbird"],
    "music": ["elisa", "strawberry", "rhythmbox", "lollypop", "amberol", "audacious"],
    "calendar": ["merkuro-calendar", "korganizer", "gnome-calendar"],
    "terminal": ["konsole", "kitty", "alacritty", "foot", "gnome-terminal", "xterm"],
    "settings": ["systemsettings"],
}
# KDE settings pages the shell may open (systemsettings MODULE)
KCMS = {"wifi": "kcm_networkmanagement", "sound": "kcm_pulseaudio", "bluetooth": "kcm_bluetooth",
        "power": "kcm_powerdevilprofilesconfig", "display": "kcm_kscreen", "users": "kcm_users"}
PLACES = {"Downloads": "~/Downloads", "Home": "~", "trash": "trash:/"}


def which_app(aid):
    if aid == "terminal" and os.environ.get("TERMINAL") and shutil.which(os.environ["TERMINAL"]):
        return os.environ["TERMINAL"]
    if aid == "web":
        return run_quiet(["xdg-settings", "get", "default-web-browser"]).stdout.strip() or shutil.which("firefox")
    return next((c for c in APPS.get(aid, []) if shutil.which(c)), None)


def app_listing():
    return {aid: which_app(aid) for aid in [*APPS, "web"]}


def spawn(cmd):
    subprocess.Popen(cmd, cwd=os.path.expanduser("~"), start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_app(aid, arg=""):
    if aid == "web":
        # the browser picked at first boot or in Settings is the system default
        desktop = run_quiet(["xdg-settings", "get", "default-web-browser"]).stdout.strip()
        if desktop and shutil.which("gtk-launch"):
            spawn(["gtk-launch", desktop])
        elif shutil.which("firefox"):
            spawn(["firefox"])
        else:
            return 404, {"error": "no browser installed"}
        return 202, {"opened": desktop or "firefox"}
    if aid == "kcm":
        if arg not in KCMS or not shutil.which("systemsettings"):
            return 404, {"error": "unknown settings page"}
        spawn(["systemsettings", KCMS[arg]])
        return 202, {"opened": KCMS[arg]}
    cmd = which_app(aid)
    if not cmd:
        return 404, {"error": f"no {aid} app installed"}
    where = PLACES.get(arg)
    if aid == "files" and where:
        spawn([cmd, where if where.startswith("trash:") else os.path.expanduser(where)])
    else:
        spawn([cmd])
    return 202, {"opened": cmd}


# Control Center: the real radios and volume.
def run_out(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=4).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def system_state():
    st = {"wifi": None, "bluetooth": None, "volume": None, "muted": None}
    if shutil.which("nmcli"):
        out = run_out(["nmcli", "radio", "wifi"]).strip()
        st["wifi"] = out == "enabled" if out else None
    if shutil.which("bluetoothctl"):
        out = run_out(["bluetoothctl", "show"])
        st["bluetooth"] = ("Powered: yes" in out) if "Controller" in out else None
    if shutil.which("wpctl"):
        m = re.search(r"Volume: ([0-9.]+)( \[MUTED\])?", run_out(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]))
        if m:
            st["volume"], st["muted"] = float(m.group(1)), bool(m.group(2))
    return st


def set_system(what, val):
    if what == "wifi" and val in ("on", "off") and shutil.which("nmcli"):
        run_out(["nmcli", "radio", "wifi", val])
    elif what == "bluetooth" and val in ("on", "off") and shutil.which("bluetoothctl"):
        run_out(["bluetoothctl", "power", val])
    elif what == "volume" and val.isdigit() and shutil.which("wpctl"):
        run_out(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{min(100, int(val))}%"])
    else:
        return 404, {"error": "unknown setting"}
    return 200, system_state()


# Sleep, restart, shut down and lock go through the session, like Plasma's own menu.
def power(what):
    if what == "lock":
        cmd = ["loginctl", "lock-session"]
    elif what == "sleep":
        cmd = ["systemctl", "suspend"]
    elif what in ("restart", "shutdown", "logout"):
        method = {"restart": "promptReboot", "shutdown": "promptShutDown", "logout": "promptLogout"}[what]
        cmd = ["gdbus", "call", "--session", "--dest", "org.kde.LogoutPrompt", "--object-path", "/LogoutPrompt",
               "--method", "org.kde.LogoutPrompt." + method]
    else:
        return 404, {"error": "unknown action"}
    if not shutil.which(cmd[0]):
        return 404, {"error": cmd[0] + " missing"}
    spawn(cmd)
    return 202, {"ok": True}


class Api(BaseHTTPRequestHandler):
    def reply(self, code, body):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/desktops":
            return self.reply(200, listing())
        if self.path == "/packs":
            return self.reply(200, pack_listing())
        if self.path == "/browsers":
            return self.reply(200, browser_listing())
        if self.path.startswith("/events"):
            try:
                after = int(self.path.split("after=", 1)[1]) if "after=" in self.path else 0
            except ValueError:
                after = -1
            return self.reply(200, events_after(after))
        if self.path == "/live":
            return self.reply(200, {"live": os.path.isdir("/run/archiso")})
        if self.path == "/debug":
            return self.reply(200, {"acks": acks, "raise": last_raise, "events": events[-5:]})
        if self.path == "/apps":
            return self.reply(200, app_listing())
        if self.path == "/system":
            return self.reply(200, system_state())
        self.reply(404, {"error": "not found"})

    def do_POST(self):
        if self.path == "/event/launcher":
            push_event("launcher")
            return self.reply(202, {"ok": True})
        if self.path.startswith("/ack/"):     # the shell saying it acted on an event (boot-test trace)
            k = self.path[5:]
            acks[k] = {"n": acks.get(k, {}).get("n", 0) + 1, "at": __import__("time").strftime("%H:%M:%S")}
            return self.reply(200, acks)
        if self.path == "/raise":
            return self.reply(*raise_shell())
        if self.path.startswith("/open/"):
            parts = self.path.split("/")[2:] + [""]
            return self.reply(*open_app(parts[0], parts[1]))
        if self.path.startswith("/system/"):
            parts = self.path.split("/")[2:] + [""]
            return self.reply(*set_system(parts[0], parts[1]))
        if self.path.startswith("/power/"):
            return self.reply(*power(self.path.rsplit("/", 1)[-1]))
        if self.path == "/install-os":
            if not os.path.isdir("/run/archiso") or not shutil.which("firelamp-install"):
                return self.reply(404, {"error": "not a live session"})
            subprocess.Popen(["firelamp-install"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return self.reply(202, {"state": "opening"})
        did = self.path.rsplit("/", 1)[-1]
        if self.path.startswith("/browser/"):
            if did not in BROWSERS:
                return self.reply(404, {"error": "unknown browser"})
            if jobs.get("browser:" + did, {}).get("state") != "installing":
                threading.Thread(target=pick_browser, args=(did,), daemon=True).start()
            return self.reply(202, {"state": "installing"})
        for verb, fn in (("/install-pack/", install_pack), ("/remove-pack/", remove_pack)):
            if self.path.startswith(verb):
                if did not in PACKS:
                    return self.reply(404, {"error": "unknown pack"})
                if jobs.get("pack:" + did, {}).get("state") != "installing":
                    threading.Thread(target=fn, args=(did,), daemon=True).start()
                return self.reply(202, {"state": "installing"})
        if not self.path.startswith("/install/") or did not in CATALOG:
            return self.reply(404, {"error": "unknown desktop"})
        if jobs.get(did, {}).get("state") == "installing":
            return self.reply(202, {"state": "installing"})
        threading.Thread(target=install, args=(did,), daemon=True).start()
        self.reply(202, {"state": "installing"})

    def log_message(self, *a):
        pass


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    if cmd == "list":
        for d in listing():
            print(f"{d['id']:10} {'installed' if d['installed'] else '-':10} {' '.join(d['packages'])}")
    elif cmd == "browsers":
        info = browser_listing()
        for b in info["browsers"]:
            mark = "default" if b["id"] == info["default"] else "installed" if b["installed"] else "-"
            print(f"{b['id']:12} {b['via']:8} {mark:10} {b['icon'] or ''}")
    elif cmd == "browser" and len(sys.argv) > 2 and sys.argv[2] in BROWSERS:
        sys.exit(0 if pick_browser(sys.argv[2]) else 1)
    elif cmd == "packs":
        for d in pack_listing():
            print(f"{d['id']:8} {'installed' if d['installed'] else '-':10} {' '.join(d['packages'])}")
    elif cmd in ("install-pack", "remove-pack") and len(sys.argv) > 2 and sys.argv[2] in PACKS:
        sys.exit(0 if (install_pack if cmd == "install-pack" else remove_pack)(sys.argv[2]) else 1)
    elif cmd == "install" and len(sys.argv) > 2 and sys.argv[2] in CATALOG:
        sys.exit(0 if install(sys.argv[2]) else 1)
    elif cmd == "launcher":
        import urllib.request
        try:
            urllib.request.urlopen(urllib.request.Request(f"http://127.0.0.1:{PORT}/event/launcher", method="POST"), timeout=2)
        except OSError as e:
            sys.exit(f"firelamp-desktops: serve isn't running ({e})")
    elif cmd == "serve":
        threading.Thread(target=refresh_appstream, daemon=True).start()
        threading.Thread(target=serve_dbus, daemon=True).start()
        ThreadingHTTPServer(("127.0.0.1", PORT), Api).serve_forever()
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
