#!/usr/bin/env bash
# Launches the Firelamp shell on top of the desktop.
#
# Lookup order:
#   1. $FIRELAMP_SHELL_CMD                       any command, for development
#   2. /usr/lib/firelamp/shell/firelamp-shell    compiled shell binary
#   3. /usr/share/firelamp/shell/Main.qml        QML shell, run with Qt's qml tool
# With none of these installed it exits and leaves the desktop as it is.
set -u

# VMs without a GPU render node: render Qt Quick in software.
if ! compgen -G '/dev/dri/renderD*' >/dev/null; then
    export QT_QUICK_BACKEND=software
fi

# Looks export and import as .firelamp-look files, read and written from QML.
export QML_XHR_ALLOW_FILE_READ=1 QML_XHR_ALLOW_FILE_WRITE=1

if [[ -n "${FIRELAMP_SHELL_CMD:-}" ]]; then
    exec bash -c "$FIRELAMP_SHELL_CMD"
elif [[ -x /usr/lib/firelamp/shell/firelamp-shell ]]; then
    exec /usr/lib/firelamp/shell/firelamp-shell "$@"
elif [[ -f /usr/share/firelamp/shell/Main.qml ]]; then
    # On Wayland with layer-shell-qt's QML module, run the layered shell: desktop, bar, dock,
    # launcher and the AI's layer as separate layer surfaces, so real apps stack between them.
    # If it can't load (old layer-shell-qt), fall back to the single full-screen window.
    shell=/usr/share/firelamp/shell
    if [[ -n "${WAYLAND_DISPLAY:-}" && -d /usr/lib/qt6/qml/org/kde/layershell && -f $shell/Layered.qml ]]; then
        started=$SECONDS
        /usr/lib/qt6/bin/qml -I "$shell" "$shell/Layered.qml" "$@" && exit 0
        # only fall back when it failed to start, not after a long session
        (( SECONDS - started < 10 )) || exit 1
        echo "firelamp-shell: layered shell failed, using the single window" >&2
    fi
    exec /usr/lib/qt6/bin/qml -I "$shell" "$shell/Main.qml" "$@"
fi
echo "firelamp-shell: no shell installed" >&2
