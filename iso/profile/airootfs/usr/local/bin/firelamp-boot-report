#!/usr/bin/env bash
# Writes the desktop session's boot status to the first serial port, so a
# headless VM (CI, QEMU -serial) can tell whether the desktop came up.
# Harmless on real hardware: it gives up quickly if there is no serial port.
port=/dev/ttyS0
report=/run/user/1000/firelamp-boot-report.txt

# QEMU boot test only: hand the session the test brain (fw_cfg files are readable by root only).
brain=/sys/firmware/qemu_fw_cfg/by_name/opt/firelamp/test-brain/raw
if [[ -e $brain ]]; then
    install -d -m 755 /run/firelamp
    install -m 644 "$brain" /run/firelamp/test-brain
fi

for _ in $(seq 240); do
    [[ -s "$report" ]] && break
    sleep 1
done

{
    echo
    echo '=== FIRELAMP BOOT REPORT ==='
    cat "$report" 2>/dev/null || echo 'FIRELAMP_SESSION_MISSING no session report after 240s'
    echo '--- display manager ---'
    journalctl -b -u sddm --no-pager -q 2>/dev/null | tail -n 15
    echo '--- shell log ---'
    tail -n 40 /home/firelamp/.local/state/firelamp/shell.log 2>/dev/null
    echo '--- shell messages in the journal ---'
    journalctl -b --no-pager -q _UID=1000 2>/dev/null | grep -iE 'qml|layer|firelamp' | tail -n 25
    echo '--- installer output ---'
    tail -n 40 /run/user/1000/firelamp-install.log 2>/dev/null
    echo '--- installer session log ---'
    tail -n 60 /root/.cache/calamares/session.log 2>/dev/null
    echo '--- errors this boot ---'
    journalctl -b -p err --no-pager -q 2>/dev/null | tail -n 30
    echo '=== END FIRELAMP BOOT REPORT ==='
} | timeout 10 tee "$port" >/dev/null 2>&1

# The capsule test (QEMU only) writes what the host needs to click Stop; pass it to the serial port.
capsule=/run/user/1000/firelamp-capsule.txt
if [[ -e /sys/firmware/qemu_fw_cfg/by_name/opt/firelamp/test-brain/raw ]]; then
    (
        sent=0
        for _ in $(seq 120); do
            sleep 2
            [[ -f "$capsule" ]] || continue
            total=$(wc -l <"$capsule")
            if (( total > sent )); then
                tail -n +"$((sent + 1))" "$capsule" | head -n "$((total - sent))" | timeout 10 tee "$port" >/dev/null 2>&1
                sent=$total
            fi
            grep -q 'STOP RESULT\|STOP SKIPPED' "$capsule" && break
        done
    ) &
fi

# The boot test taps Super after reading the report. Watch the shell's trace for
# the next launcher-key ack and write it to the serial port too.
before=$(curl -s --max-time 5 127.0.0.1:7341/debug)
for _ in $(seq 90); do
    sleep 2
    now=$(curl -s --max-time 5 127.0.0.1:7341/debug)
    if [[ -n "$now" && "$now" != "$before" ]]; then
        sleep 3
        { echo '=== FIRELAMP SUPER DEBUG ==='; curl -s --max-time 5 127.0.0.1:7341/debug; echo; echo '=== END FIRELAMP SUPER DEBUG ==='; } \
            | timeout 10 tee "$port" >/dev/null 2>&1
        break
    fi
done
wait
exit 0
