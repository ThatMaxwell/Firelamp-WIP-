#!/usr/bin/env python3
"""Print the live AT-SPI2 UI tree: the same view of the screen the AI gets.

    firelamp-a11y-probe              print every app's tree (depth 6)
    firelamp-a11y-probe --depth 3    limit tree depth
    firelamp-a11y-probe --boot-report
                                     wait for the session to settle, then write a
                                     short status summary to
                                     $XDG_RUNTIME_DIR/firelamp-boot-report.txt
"""
import argparse
import os
import json
import re
import shutil
import subprocess
import sys
import time

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi  # noqa: E402


def describe(node):
    try:
        role = node.get_role_name()
    except Exception:
        role = "?"
    try:
        name = node.get_name() or ""
    except Exception:
        name = ""
    extra = ""
    try:
        ext = node.get_extents(Atspi.CoordType.SCREEN)
        extra = f" @{ext.x},{ext.y} {ext.width}x{ext.height}"
    except Exception:
        pass
    return f"[{role}] {name!r}{extra}"


def walk(node, depth, max_depth, lines, counter):
    counter[0] += 1
    lines.append("  " * depth + describe(node))
    if depth >= max_depth:
        return
    try:
        count = node.get_child_count()
    except Exception:
        return
    for i in range(count):
        try:
            child = node.get_child_at_index(i)
        except Exception:
            continue
        if child is not None:
            walk(child, depth + 1, max_depth, lines, counter)


def snapshot(max_depth):
    desktop = Atspi.get_desktop(0)
    lines, counter, apps = [], [0], []
    for i in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(i)
        if app is None:
            continue
        apps.append(app.get_name() or "?")
        walk(app, 0, max_depth, lines, counter)
    return apps, counter[0], lines


def run(cmd, timeout=5):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except Exception as exc:
        return f"({exc})"


def shell_env():
    pid = run(["pgrep", "-n", "-f", "qt6/bin/qml|firelamp/shell/firelamp-shell"]).split("\n")[0]
    try:
        with open(f"/proc/{pid}/environ", "rb") as fh:
            env = fh.read().decode(errors="replace").split("\0")
    except OSError as exc:
        return f"({exc})"
    return " ".join(e for e in env if e.startswith(("QT_", "DBUS_", "XDG_RUNTIME", "WAYLAND")))


def greeter_check(theme="/usr/share/sddm/themes/firelamp"):
    """Load the SDDM login theme in test mode; the live ISO autologins, so it is never shown otherwise."""
    if not os.path.isdir(theme):
        return "not present"
    greeter = shutil.which("sddm-greeter-qt6") or shutil.which("sddm-greeter")
    if not greeter:
        return "ERROR no sddm-greeter"
    try:
        res = subprocess.run([greeter, "--test-mode", "--theme", theme], capture_output=True, text=True, timeout=8)
        log = res.stdout + res.stderr
    except subprocess.TimeoutExpired as exc:
        # Still running after 8 s means the theme loaded and the greeter is waiting for a login.
        log = (exc.stdout or b"").decode(errors="replace") + (exc.stderr or b"").decode(errors="replace")
    fatal = re.compile(r"is not a type|is not installed|Type \w+ unavailable|Syntax error|Expected token|failed to load|Cannot load", re.I)
    errors = [l.strip() for l in log.splitlines() if fatal.search(l)]
    return ("ERROR " + " | ".join(errors[:5])) if errors else "OK"


def helper(method, path, timeout=30, limit=300):
    import urllib.request
    try:
        req = urllib.request.Request("http://127.0.0.1:7341" + path, method=method, data=b"" if method == "POST" else None)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read().decode(errors="replace")[:limit]
    except Exception as exc:
        return f"ERROR {exc}"


def launcher_checks():
    """Super-key path: KWin config -> org.firelamp.Shell -> helper event the shell long-polls."""
    out = ["kwin meta key: " + (run(["kreadconfig6", "--file", "kwinrc", "--group", "ModifierOnlyShortcuts", "--key", "Meta"]) or "(unset)")]
    owned = run(["busctl", "--user", "status", "org.firelamp.Shell"])
    out.append("shell bus name: " + ("OWNED " + owned.splitlines()[0] if owned and not owned.startswith("(") and "PID=" in owned else "NOT OWNED " + owned[:120]))
    run(["gdbus", "call", "--session", "--dest", "org.firelamp.Shell", "--object-path", "/org/firelamp/Shell",
         "--method", "org.firelamp.Shell.ToggleLauncher"])
    out.append("launcher event: " + helper("GET", "/events?after=-1"))
    time.sleep(3)
    # The shell's own trace of the open: acks and the raw /raise output.
    out.append("launcher debug: " + helper("GET", "/debug", limit=4000))
    # Close it again so the boot test's Super tap opens it on camera.
    run(["gdbus", "call", "--session", "--dest", "org.firelamp.Shell", "--object-path", "/org/firelamp/Shell",
         "--method", "org.firelamp.Shell.ToggleLauncher"])
    return out


def open_check(route, proc, wait=30):
    """Open an app the way the dock does and report whether its process came up."""
    reply = helper("POST", "/open/" + route)
    for _ in range(wait):
        time.sleep(1)
        pid = run(["pgrep", "-a", "-x", proc])
        if pid:
            return "RUNNING " + pid
    return "NOT RUNNING " + reply


def agent_check():
    """The assistant should be serving, and honest that no brain is set up on a fresh session."""
    out = run(["/usr/local/bin/firelamp-agent", "status"], timeout=20)
    try:
        st = json.loads(out)
    except ValueError:
        return "NOT RUNNING " + out[:300]
    ydotoold = run(["pgrep", "-a", "-x", "ydotoold"]) or "ydotoold NOT RUNNING"
    return "RUNNING brain=%s keyboard=%s shell=%s (%s)" % (
        json.dumps(st.get("brain")), st.get("keyboard"), st.get("shell"), ydotoold)


# fw_cfg files are root-only; firelamp-boot-report (root) copies this one here for the session.
TEST_BRAIN = "/run/firelamp/test-brain"


def agent_call(method, path, body=None, timeout=30):
    import urllib.request
    data = json.dumps(body).encode() if body is not None else (b"" if method == "POST" else None)
    req = urllib.request.Request("http://127.0.0.1:7342" + path, method=method, data=data,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode() or "{}")


def find_button(name, deadline):
    """The first button called `name` in any app, with its window (for the surface size)."""
    def search(node, win, depth):
        if depth > 25:
            return None
        try:
            if node.get_role_name() == "push button" or node.get_role_name() == "button":
                if (node.get_name() or "") == name:
                    return node, win
            n = node.get_child_count()
        except Exception:
            return None
        for i in range(n):
            try:
                c = node.get_child_at_index(i)
            except Exception:
                continue
            if c is not None:
                hit = search(c, win if depth else c, depth + 1)
                if hit:
                    return hit
        return None
    while time.time() < deadline:
        desktop = Atspi.get_desktop(0)
        for i in range(desktop.get_child_count()):
            app = desktop.get_child_at_index(i)
            if app is None:
                continue
            for j in range(app.get_child_count() or 0):
                w = app.get_child_at_index(j)
                if w is None:
                    continue
                hit = search(w, w, 1)
                if hit:
                    return hit
        time.sleep(1)
    return None


def screen_size():
    import glob
    for f in sorted(glob.glob("/sys/class/drm/card*-*/modes")):
        try:
            first = open(f).readline().strip()
        except OSError:
            continue
        if "x" in first:
            w, h = first.split("x")[:2]
            return int(w), int("".join(ch for ch in h if ch.isdigit()))
    return 1280, 800


def capsule_test():
    try:
        _capsule_test()
    except Exception as exc:  # the host waits for a line either way
        out = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "firelamp-capsule.txt")
        with open(out, "a") as fh:
            fh.write(f"=== FIRELAMP STOP SKIPPED the test crashed: {exc!r} ===\n")


def _capsule_test():
    """Boot test only (QEMU passes a test brain): start a real task, find the capsule's Stop button
    over AT-SPI, hand its screen position to the host, which clicks it with QEMU's tablet."""
    # firelamp-boot-report (root) copies these lines to the serial port for the host.
    out = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "firelamp-capsule.txt")

    def say(text):
        with open(out, "a") as fh:
            fh.write(text + "\n")
    for _ in range(120):
        if os.path.exists(TEST_BRAIN):
            break
        time.sleep(1)
    try:
        base, _, model = open(TEST_BRAIN).read().strip().partition("|")
    except OSError as exc:
        say(f"=== FIRELAMP STOP SKIPPED no test brain: {exc} ===")
        return
    # Start once the boot report is out and the host has tapped Super.
    report = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "firelamp-boot-report.txt")
    for _ in range(300):
        if os.path.exists(report):
            break
        time.sleep(1)
    time.sleep(15)
    try:
        agent_call("POST", "/config", {"api_base": base, "api_key": "ollama", "api_model": model})
        agent_call("POST", "/ask", {"text": "Open a text editor and start a to-do list", "settings": {}})
    except Exception as exc:
        say(f"=== FIRELAMP STOP SKIPPED could not start a task: {exc} ===")
        return
    hit = find_button("Stop", time.time() + 90)
    if not hit:
        say("=== FIRELAMP STOP SKIPPED no Stop button on the AT-SPI tree within 90s ===")
        return
    btn, win = hit
    b = btn.get_extents(Atspi.CoordType.WINDOW)
    w = win.get_extents(Atspi.CoordType.WINDOW)
    sw, _ = screen_size()
    # The capsule surface is anchored top-centre just under the 28px bar (Layered.qml), and Wayland
    # gives clients no global position, so place the button within that surface.
    if b.width > 0 and b.height > 0:
        x = (sw - w.width) // 2 + b.x + b.width // 2
        y = 28 + b.y + b.height // 2
    else:
        # Qt reported no extents for it: use the capsule's layout (Layered.qml / AgentCapsule.qml):
        # the surface is the capsule plus 24px each side, Stop's centre is 18px in from the
        # capsule's right edge, and the capsule's centre line is at y 58.
        x = sw // 2 + (w.width - 48) // 2 - 18
        y = 58
    say(f"=== FIRELAMP STOP AT {x} {y} button={b.x},{b.y} {b.width}x{b.height} surface={w.width}x{w.height} screen_w={sw} ===")
    # Proof is the agent's own end-of-task event: Stop in the shell posts /stop, and the task
    # ends with how=stopped. Any other ending means the click didn't land.
    end = time.time() + 90
    while time.time() < end:
        try:
            ev = agent_call("GET", "/events?after=-1", timeout=30).get("events", [])
        except Exception:
            time.sleep(2)
            continue
        done = [e for e in ev if e.get("kind") == "done"]
        if done:
            say(f"=== FIRELAMP STOP RESULT task ended how={done[-1].get('how')} ===")
            return
        time.sleep(2)
    say("=== FIRELAMP STOP RESULT task still running 90s after the Stop position was sent ===")


def installer_check(wait=45):
    """Start the installer the way the desktop button does and report whether its window stays up."""
    log = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "firelamp-install.log")
    with open(log, "w") as fh:
        subprocess.Popen(["firelamp-install"], start_new_session=True, stdout=fh, stderr=subprocess.STDOUT)
    for _ in range(wait):
        time.sleep(1)
        if run(["pgrep", "-x", "calamares"]) and _ >= 15:
            return "RUNNING " + run(["pgrep", "-a", "-x", "calamares"])
    return "NOT RUNNING"


def boot_report():
    time.sleep(20)
    out = []
    out.append(f"FIRELAMP_SESSION wayland={os.environ.get('WAYLAND_DISPLAY', '-')}")
    compositor = ""
    for name in ("kwin_wayland", "labwc", "niri", "Hyprland", "sway", "gnome-shell", "cosmic-comp"):
        compositor = run(["pgrep", "-a", "-x", name])
        if compositor:
            break
    out.append("compositor: " + (compositor or "NOT RUNNING"))
    out.append("desktop: " + os.environ.get("XDG_CURRENT_DESKTOP", "-") + " " + (run(["pgrep", "-a", "-x", "plasmashell"]) or "(no plasmashell)"))
    out.append("kernel: " + run(["uname", "-r"]))
    out.append("installer: " + (run(["pacman", "-Q", "cachyos-calamares-next"]) or "NOT INSTALLED"))
    out.append("shell: " + (run(["pgrep", "-a", "-f", "qt6/bin/qml|firelamp/shell/firelamp-shell"]) or "NOT RUNNING"))
    out.append("qt: " + run(["/usr/lib/qt6/bin/qtpaths6", "--qt-version"]))
    out.append("renderer: " + os.environ.get("WLR_RENDERER", "auto"))
    out.append("a11y bus enabled: " + run(["busctl", "--user", "get-property", "org.a11y.Bus", "/org/a11y/bus", "org.a11y.Status", "IsEnabled"]))
    out.append("a11y launcher: " + (run(["pgrep", "-a", "-f", "at-spi"]) or "NOT RUNNING"))
    try:
        # Apps register on the bus a moment after they start; give them time.
        for _ in range(30):
            apps, nodes, lines = snapshot(4)
            if apps:
                break
            time.sleep(2)
        if not apps:
            out.append("shell env: " + shell_env())
        out.append(f"FIRELAMP_ATSPI_OK apps={len(apps)} nodes={nodes} names={apps}")
        out.extend(lines[:40])
    except Exception as exc:
        out.append(f"FIRELAMP_ATSPI_FAIL {exc}")
    out.append("login theme: " + greeter_check())
    out.append("layershell qml: " + ("OK" if os.path.isdir("/usr/lib/qt6/qml/org/kde/layershell") else "MISSING"))
    out.append("plasma panels: " + run(["gdbus", "call", "--session", "--dest", "org.kde.plasmashell", "--object-path", "/PlasmaShell",
                                        "--method", "org.kde.PlasmaShell.evaluateScript", "print(panels().length)"]))
    out.extend(launcher_checks())
    out.append("agent: " + agent_check())
    out.append("terminal window: " + open_check("terminal", "konsole"))
    out.append("files window: " + open_check("files", "dolphin"))
    out.append("web window: " + open_check("web", "firefox", wait=45))
    out.append("installer window: " + installer_check())
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "firelamp-boot-report.txt")
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("\n".join(out) + "\n")
    os.replace(tmp, path)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--depth", type=int, default=6)
    parser.add_argument("--boot-report", action="store_true")
    parser.add_argument("--capsule-test", action="store_true")
    args = parser.parse_args()
    if args.capsule_test:
        capsule_test()
        return
    if args.boot_report:
        boot_report()
        return
    apps, nodes, lines = snapshot(args.depth)
    print("\n".join(lines))
    print(f"\n{len(apps)} apps, {nodes} nodes", file=sys.stderr)


if __name__ == "__main__":
    main()
