#!/usr/bin/env python3
"""Print the live AT-SPI2 UI tree: the same view of the screen the AI gets.

    firelamp-a11y-probe              print every app's tree (depth 6)
    firelamp-a11y-probe --depth 3    limit tree depth
    firelamp-a11y-probe --boot-report
                                     wait for the session to settle, then write a
                                     short status summary to
                                     $XDG_RUNTIME_DIR/firelamp-boot-report.txt
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
import time

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi  # noqa: E402


def describe(node):
    try:
        role = node.get_role_name()
    except Exception:
        role = "?"
    try:
        name = node.get_name() or ""
    except Exception:
        name = ""
    extra = ""
    try:
        ext = node.get_extents(Atspi.CoordType.SCREEN)
        extra = f" @{ext.x},{ext.y} {ext.width}x{ext.height}"
    except Exception:
        pass
    return f"[{role}] {name!r}{extra}"


def walk(node, depth, max_depth, lines, counter):
    counter[0] += 1
    lines.append("  " * depth + describe(node))
    if depth >= max_depth:
        return
    try:
        count = node.get_child_count()
    except Exception:
        return
    for i in range(count):
        try:
            child = node.get_child_at_index(i)
        except Exception:
            continue
        if child is not None:
            walk(child, depth + 1, max_depth, lines, counter)


def snapshot(max_depth):
    desktop = Atspi.get_desktop(0)
    lines, counter, apps = [], [0], []
    for i in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(i)
        if app is None:
            continue
        apps.append(app.get_name() or "?")
        walk(app, 0, max_depth, lines, counter)
    return apps, counter[0], lines


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception as exc:
        return f"({exc})"


def shell_env():
    pid = run(["pgrep", "-n", "-f", "qt6/bin/qml|firelamp/shell/firelamp-shell"]).split("\n")[0]
    try:
        with open(f"/proc/{pid}/environ", "rb") as fh:
            env = fh.read().decode(errors="replace").split("\0")
    except OSError as exc:
        return f"({exc})"
    return " ".join(e for e in env if e.startswith(("QT_", "DBUS_", "XDG_RUNTIME", "WAYLAND")))


def greeter_check(theme="/usr/share/sddm/themes/firelamp"):
    """Load the SDDM login theme in test mode; the live ISO autologins, so it is never shown otherwise."""
    if not os.path.isdir(theme):
        return "not present"
    greeter = shutil.which("sddm-greeter-qt6") or shutil.which("sddm-greeter")
    if not greeter:
        return "ERROR no sddm-greeter"
    try:
        res = subprocess.run([greeter, "--test-mode", "--theme", theme], capture_output=True, text=True, timeout=8)
        log = res.stdout + res.stderr
    except subprocess.TimeoutExpired as exc:
        # Still running after 8 s means the theme loaded and the greeter is waiting for a login.
        log = (exc.stdout or b"").decode(errors="replace") + (exc.stderr or b"").decode(errors="replace")
    fatal = re.compile(r"is not a type|is not installed|Type \w+ unavailable|Syntax error|Expected token|failed to load|Cannot load", re.I)
    errors = [l.strip() for l in log.splitlines() if fatal.search(l)]
    return ("ERROR " + " | ".join(errors[:5])) if errors else "OK"


def boot_report():
    time.sleep(20)
    out = []
    out.append(f"FIRELAMP_SESSION wayland={os.environ.get('WAYLAND_DISPLAY', '-')}")
    compositor = ""
    for name in ("kwin_wayland", "labwc", "niri", "Hyprland", "sway", "gnome-shell", "cosmic-comp"):
        compositor = run(["pgrep", "-a", "-x", name])
        if compositor:
            break
    out.append("compositor: " + (compositor or "NOT RUNNING"))
    out.append("desktop: " + os.environ.get("XDG_CURRENT_DESKTOP", "-") + " " + (run(["pgrep", "-a", "-x", "plasmashell"]) or "(no plasmashell)"))
    out.append("kernel: " + run(["uname", "-r"]))
    out.append("installer: " + (run(["pacman", "-Q", "cachyos-calamares-next"]) or "NOT INSTALLED"))
    out.append("shell: " + (run(["pgrep", "-a", "-f", "qt6/bin/qml|firelamp/shell/firelamp-shell"]) or "NOT RUNNING"))
    out.append("qt: " + run(["/usr/lib/qt6/bin/qtpaths6", "--qt-version"]))
    out.append("renderer: " + os.environ.get("WLR_RENDERER", "auto"))
    out.append("a11y bus enabled: " + run(["busctl", "--user", "get-property", "org.a11y.Bus", "/org/a11y/bus", "org.a11y.Status", "IsEnabled"]))
    out.append("a11y launcher: " + (run(["pgrep", "-a", "-f", "at-spi"]) or "NOT RUNNING"))
    try:
        # Apps register on the bus a moment after they start; give them time.
        for _ in range(30):
            apps, nodes, lines = snapshot(4)
            if apps:
                break
            time.sleep(2)
        if not apps:
            out.append("shell env: " + shell_env())
        out.append(f"FIRELAMP_ATSPI_OK apps={len(apps)} nodes={nodes} names={apps}")
        out.extend(lines[:40])
    except Exception as exc:
        out.append(f"FIRELAMP_ATSPI_FAIL {exc}")
    out.append("login theme: " + greeter_check())
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "firelamp-boot-report.txt")
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write("\n".join(out) + "\n")
    os.replace(tmp, path)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--depth", type=int, default=6)
    parser.add_argument("--boot-report", action="store_true")
    args = parser.parse_args()
    if args.boot_report:
        boot_report()
        return
    apps, nodes, lines = snapshot(args.depth)
    print("\n".join(lines))
    print(f"\n{len(apps)} apps, {nodes} nodes", file=sys.stderr)


if __name__ == "__main__":
    main()
