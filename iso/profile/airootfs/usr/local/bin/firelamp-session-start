#!/usr/bin/env bash
# Runs once at the start of every graphical session, whatever the desktop
# (KDE Plasma by default, or any desktop installed from Settings).
#
#  1. Turns on the AT-SPI2 accessibility bus, as a screen reader would. Qt and
#     GTK apps only publish their UI tree once this is set, and the AI reads
#     the screen through that tree.
#  2. Starts the Firelamp shell on top of the desktop, unless turned off with
#     `touch ~/.config/firelamp/no-shell` or the firelamp.noshell boot option.
#     On Plasma it removes Plasma's own panel once, since the shell has its
#     own bar and dock; Plasma keeps the desktop and wallpaper.
#  3. Records what the AI can see, for boot diagnostics.
state="${XDG_STATE_HOME:-$HOME/.local/state}/firelamp"
mkdir -p "$state"

busctl --user call org.a11y.Bus /org/a11y/bus org.a11y.Bus GetAddress >/dev/null 2>&1
busctl --user set-property org.a11y.Bus /org/a11y/bus org.a11y.Status IsEnabled b true >/dev/null 2>&1

# The QEMU boot test (iso/test-boot.py) passes this fw_cfg entry so the shell
# skips first-boot naming and the test can reach the desktop. Real hardware
# never has it.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/firelamp/shell.conf"
if [[ -e /sys/firmware/qemu_fw_cfg/by_name/opt/firelamp/skip-onboarding/raw && ! -e "$cfg" ]]; then
    mkdir -p "$(dirname "$cfg")"
    printf '[General]\nassistantName=Test\npacksAsked=true\nbrowserAsked=true\n' >"$cfg"
fi

if [[ ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/firelamp/no-shell" ]] && ! grep -qw firelamp.noshell /proc/cmdline; then
    /usr/local/bin/firelamp-shell >>"$state/shell.log" 2>&1 &
    if [[ ":$XDG_CURRENT_DESKTOP:" == *:KDE:* && ! -e "$state/plasma-panel-removed" ]]; then
        (
            for _ in $(seq 60); do
                gdbus call --session --dest org.kde.plasmashell --object-path /PlasmaShell \
                    --method org.kde.PlasmaShell.evaluateScript \
                    'var ps = panels(); if (!ps.length) throw "no panel yet"; ps.forEach(function (p) { p.remove(); })' >/dev/null 2>&1 \
                    && { touch "$state/plasma-panel-removed"; break; }
                sleep 2
            done
        ) &
    fi
fi

/usr/local/bin/firelamp-a11y-probe --boot-report >/dev/null 2>&1 &
