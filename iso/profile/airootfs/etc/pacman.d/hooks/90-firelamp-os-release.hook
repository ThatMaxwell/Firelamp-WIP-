# Brand the system as Firelamp OS. Re-applied whenever the filesystem
# package (which owns os-release) is installed or upgraded.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Applying Firelamp OS branding to os-release...
When = PostTransaction
Exec = /usr/bin/cp -f /usr/share/firelamp/os-release /usr/lib/os-release
